# Configuration Stripe pour Firebase Functions
# Copiez ce fichier en .env pour le développement local

# Clé secrète Stripe (JAMAIS dans le code client!)
# Récupérez-la depuis: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_VOTRE_CLE_SECRETE_ICI

# Clé publique Stripe (utilisée côté client)
STRIPE_PUBLISHABLE_KEY=pk_test_VOTRE_CLE_PUBLIQUE_ICI

# Secret du webhook Stripe
# Récupérez-le après avoir configuré le webhook sur Stripe
# https://dashboard.stripe.com/test/webhooks
STRIPE_WEBHOOK_SECRET=whsec_VOTRE_WEBHOOK_SECRET_ICI

# Pour déployer en production, utilisez:
# firebase functions:config:set stripe.secret_key="sk_live_..." stripe.publishable_key="pk_live_..." stripe.webhook_secret="whsec_..."
